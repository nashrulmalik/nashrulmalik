---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { title = 'Muhammad Nashrul Malik — Product Designer', description = 'Product designer shaping clear, inclusive experiences for complex software.' } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#fbfaf8" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
