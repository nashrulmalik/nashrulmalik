---
import cv from '../data/cv.json';

interface Props {
	currentPage?: 'home' | 'about' | 'contact';
}

const { currentPage = 'home' } = Astro.props;
const fullName = cv.personal_info.full_name;
const linkClass = 'transition-colors hover:text-brand-blue-dark';
---

<header class="site-header wrap mx-auto grid h-28 w-[calc(100%-112px)] max-w-[1300px] grid-cols-3 items-center border-b border-[#e9e8e3] max-[900px]:h-[88px] max-[900px]:w-[calc(100%-60px)] max-[620px]:h-[76px] max-[620px]:w-[calc(100%-38px)] max-[620px]:grid-cols-[1fr_auto]">
	<a class="wordmark inline-flex w-max items-center gap-3 max-[620px]:gap-2" href="/" aria-label={`${fullName}, home`}>
		<span class="monogram font-display relative text-[27px] font-extrabold leading-none tracking-[-2.5px] text-[#26302e] max-[620px]:text-2xl" aria-hidden="true">nm<span>.</span></span>
		<span class="wordmark-name text-[13px] font-semibold tracking-[.03em] text-[#656c69] max-[620px]:text-xs">Nashrul Malik</span>
	</a>
	<p class="header-role justify-self-center text-[15px] tracking-[.01em] text-[#666e6b] max-[900px]:text-sm max-[620px]:hidden">Product Designer <span>·</span> UI/UX Specialist</p>
	<nav class="flex items-center justify-self-end gap-[35px] text-[15px] text-[#626865] max-[900px]:gap-[21px] max-[620px]:gap-2.5 max-[620px]:text-xs" aria-label="Main navigation">
		<a class:list={[linkClass, currentPage === 'home' && 'text-brand-blue-dark']} href="/#work" aria-current={currentPage === 'home' ? 'page' : undefined}>work</a>
		<a class:list={[linkClass, currentPage === 'about' && 'text-brand-blue-dark']} href="/about/" aria-current={currentPage === 'about' ? 'page' : undefined}>about</a>
		<a class:list={[linkClass, currentPage === 'contact' && 'text-brand-blue-dark']} href="/contact/" aria-current={currentPage === 'contact' ? 'page' : undefined}>contact</a>
		<button class="language-toggle inline-grid min-w-10 h-10 place-items-center rounded-full border border-[#dfe3dc] bg-white px-2 text-xs font-semibold text-[#1e5fbf] transition-colors hover:bg-[#eaf1fe] focus-visible:outline-3 focus-visible:outline-brand-blue focus-visible:outline-offset-2 max-[620px]:min-w-8 max-[620px]:h-8" type="button" data-language-toggle aria-label="Switch to Arabic" title="Switch to Arabic" aria-pressed="false">عربي</button>
		<button class="theme-toggle inline-grid size-10 place-items-center rounded-full border border-[#dfe3dc] bg-white text-lg text-[#1e5fbf] transition-colors hover:bg-[#eaf1fe] focus-visible:outline-3 focus-visible:outline-brand-blue focus-visible:outline-offset-2 max-[620px]:size-8" type="button" data-theme-toggle aria-label="Switch to dark mode" title="Switch to dark mode" aria-pressed="false"><span data-theme-icon aria-hidden="true">☾</span></button>
	</nav>
</header>

<script>
	const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const themeIcon = document.querySelector<HTMLElement>('[data-theme-icon]');
	if (themeToggle) {
		const applyTheme = (theme: 'light' | 'dark') => {
			const isDark = theme === 'dark';
			document.documentElement.dataset.theme = theme;
			themeToggle.setAttribute('aria-pressed', String(isDark));
			const label = document.documentElement.lang === 'ar'
				? (isDark ? 'التبديل إلى الوضع الفاتح' : 'التبديل إلى الوضع الداكن')
				: (isDark ? 'Switch to light mode' : 'Switch to dark mode');
			themeToggle.setAttribute('aria-label', label);
			themeToggle.title = label;
			if (themeIcon) themeIcon.textContent = isDark ? '☀' : '☾';
		};

		applyTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
		themeToggle.addEventListener('click', () => {
			const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
			try { localStorage.setItem('theme', nextTheme); } catch { /* Keep the selected theme for this page view. */ }
			applyTheme(nextTheme);
		});
	}
</script>

<script>
	import { initLanguageToggle } from '../scripts/language';
	initLanguageToggle();
</script>
