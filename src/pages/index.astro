---
import Layout from '../layouts/Layout.astro';
import cv from '../data/cv.json';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const fullName = cv.personal_info.full_name;
const role = 'Product designer';
const previousWork = [
	{ title: 'Berry 8', image: '/work/berry-8.webp', alt: 'Berry 8 correspondence and workflow management dashboard', href: '/work/berry-8/' },
	{ title: 'Beautiful Push Up App', image: '/work/beautiful-push-up-app.png', alt: 'Beautiful Push Up fitness app interface designs', href: '/work/beautiful-push-up/' },
	{ title: 'Blue Sky Me App', image: '/work/blue-sky-me-app.jpg', alt: 'Blue Sky Me planning app interface designs', href: '/work/blue-sky-me/' },
	{ title: 'Berry 7', image: '/work/berry-7.avif', alt: 'Berry software design', href: null },
];
const capabilityCards = [
	{ number: '01', title: 'Complex workflows, made clear', category: 'PRODUCT DESIGN', tone: 'mint', description: 'I turn dense, technical requirements into user journeys and interfaces people can move through with confidence.', visual: 'workflow' },
	{ number: '02', title: 'A system that scales with the product', category: 'FIGMA · DESIGN SYSTEMS', tone: 'peach', description: 'I build reusable foundations that help teams stay consistent as products, platforms, and teams grow.', visual: 'system' },
	{ number: '03', title: 'Inclusive by default', category: 'ACCESSIBILITY · RTL', tone: 'blue', description: 'Accessibility, clear hierarchy, and right-to-left localization are part of the design process from the start.', visual: 'inclusive' },
	{ number: '04', title: 'Thoughtful details, ready to ship', category: 'PROTOTYPING · MOTION', tone: 'lilac', description: 'Prototypes, interaction details, and implementation guidance help ideas make the journey from Figma to product.', visual: 'motion' },
];
---

<Layout title={`${fullName} — ${role}`} description="Muhammad Nashrul Malik is a product designer shaping clear, inclusive experiences for complex software.">
	<SiteHeader currentPage="home" />

	<main id="top">
		<section class="intro wrap mx-auto grid min-h-[545px] w-[calc(100%-112px)] max-w-[1300px] grid-cols-[1fr_.9fr] items-center gap-12 pt-[75px] pb-[68px] max-[900px]:min-h-0 max-[900px]:w-[calc(100%-60px)] max-[900px]:grid-cols-2 max-[900px]:gap-5 max-[900px]:py-[60px] max-[620px]:flex max-[620px]:w-[calc(100%-38px)] max-[620px]:flex-col max-[620px]:items-stretch max-[620px]:gap-[29px] max-[620px]:pt-[49px] max-[620px]:pb-[52px]" aria-labelledby="intro-title">
			<div class="intro-copy pb-[7px] max-[620px]:p-0">
				<p class="eyebrow mb-[21px] flex items-center gap-2 text-xs font-bold tracking-[.13em] text-[#626966] max-[620px]:mb-[18px]"><span class="status-dot"></span> Available for the right opportunity <span class="eyebrow-place">· Yogyakarta, Indonesia</span></p>
				<h1 class="mb-[33px] font-display text-[clamp(54px,6.4vw,86px)] font-semibold leading-[.99] tracking-[-.072em] max-[620px]:mb-[22px] max-[620px]:text-[58px]" id="intro-title">Making complex<br /><span class="text-brand-blue">feel simple.</span></h1>
				<div class="intro-bottom max-w-[510px] border-l-2 border-[#d6efeb] pl-[18px]">
					<p class="intro-summary mb-[22px] max-w-[440px] text-[18px] leading-[1.7] text-[#636a67] max-[900px]:text-[17px] max-[620px]:text-[17px]">I’m <span data-localized-name data-en-name={fullName} data-ar-name="محمد نصر مالك" dir="auto">{fullName}</span>, a product designer who turns customer needs and intricate systems into clear, considered digital experiences.</p>
					<a class="text-link inline-flex items-center gap-[11px] text-[15px] font-bold text-brand-blue-dark max-[620px]:text-sm" href="#capabilities">Explore my approach <span aria-hidden="true">↓</span></a>
				</div>
			</div>
			<div class="hero-art" aria-label="A visual sketch of a product workflow becoming a polished interface" role="img">
				<div class="hero-orbit orbit-one"></div><div class="hero-orbit orbit-two"></div>
				<div class="hero-note note-top"><span class="note-dot"></span> customer need</div>
				<div class="hero-note note-bottom">clear next step <span>↗</span></div>
				<div class="hero-card">
					<div class="mini-top"><span class="mini-brand"><i></i><i></i><i></i></span><span class="mini-avatar">NM</span></div>
					<div class="mini-kicker">YOUR WORKSPACE</div>
					<div class="mini-title">Everything<br />in its place.</div>
					<div class="mini-row"><span class="mini-icon">✓</span><span><b>Project status</b><small>All systems operational</small></span><span class="mini-check">↗</span></div>
					<div class="mini-row"><span class="mini-icon peach-icon">⌁</span><span><b>Next milestone</b><small>Prototype review · Today</small></span><span class="mini-check">→</span></div>
				</div>
				<div class="floating-chip">Designed with care <span>✳</span></div>
				<div class="hero-caption">From tangled workflows to confident decisions.</div>
			</div>
		</section>

		<section class="previous-work wrap mx-auto w-[calc(100%-112px)] max-w-[1300px] pt-[45px] pb-[80px] max-[900px]:w-[calc(100%-60px)] max-[620px]:w-[calc(100%-38px)] max-[620px]:pt-7 max-[620px]:pb-[54px]" id="work" aria-labelledby="previous-work-title">
			<div class="mb-7 flex items-end justify-between max-[620px]:mb-[19px] max-[620px]:block">
				<div><p class="eyebrow mb-[11px] flex items-center gap-2 text-xs font-bold tracking-[.13em] text-[#626966]">PREVIOUS WORK <span class="heading-line"></span></p><h2 class="font-display text-[clamp(30px,3.3vw,42px)] font-semibold leading-[1.15] tracking-[-.055em] max-[620px]:text-[32px]" id="previous-work-title">A selection of past work<span class="accent-dot">.</span></h2></div>
				<p class="section-aside mb-[3px] text-right text-sm leading-[1.6] text-[#5b625f] max-[620px]:hidden">Product ideas brought to life<br />across mobile and web.</p>
			</div>
			<div class="grid grid-cols-2 gap-[22px] max-[620px]:grid-cols-1 max-[620px]:gap-7">
				{previousWork.map((project, index) => (
					<article class="group min-w-0">
						<figure class="relative m-0 aspect-square overflow-hidden bg-[#eaf1fe]">
							<img class="block h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]" src={project.image} alt={project.alt} loading="lazy" decoding="async" />
							<div aria-hidden="true" class="absolute inset-0 flex items-center justify-center bg-brand-blue/90 px-8 text-center text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-within:opacity-100">
								<h3 class="m-0 max-w-[18ch] font-display text-[clamp(22px,3vw,38px)] font-semibold leading-tight tracking-[-.04em]">{project.title}</h3>
							</div>
							{project.href && <a class="absolute inset-0 z-10 rounded-sm focus-visible:outline-3 focus-visible:outline-brand-blue focus-visible:outline-offset-2" href={project.href} aria-label={`View case study: ${project.title}`}></a>}
						</figure>
						<div class="mt-3 flex items-center justify-between">
							<h3 class="m-0 font-display text-lg font-semibold tracking-[-.03em] max-[620px]:text-base">{project.title}</h3>
							<span class="text-xs font-semibold tabular-nums text-[#626966]">0{index + 1}</span>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="work-section wrap mx-auto w-[calc(100%-112px)] max-w-[1300px] pt-[45px] pb-[101px] max-[900px]:w-[calc(100%-60px)] max-[620px]:w-[calc(100%-38px)] max-[620px]:pt-7 max-[620px]:pb-[68px]" id="capabilities" aria-labelledby="work-title">
			<div class="section-heading mb-7 flex items-end justify-between max-[620px]:mb-[19px] max-[620px]:block">
				<div><p class="eyebrow mb-[11px] flex items-center gap-2 text-xs font-bold tracking-[.13em] text-[#626966]">SELECTED CAPABILITIES <span class="heading-line"></span></p><h2 class="font-display text-[clamp(30px,3.3vw,42px)] font-semibold leading-[1.15] tracking-[-.055em] max-[620px]:text-[32px]" id="work-title">How I make an impact<span class="accent-dot">.</span></h2></div>
				<p class="section-aside">A few ways I can help a product team<br />move from complexity to clarity.</p>
			</div>
			<div class="impact-timeline">
				{capabilityCards.map((card, index) => (
					<article class:list={['impact-item', card.tone, index % 2 === 1 && 'reverse']}>
						<div class="timeline-art card-art" aria-hidden="true">
							{card.visual === 'workflow' && <div class="workflow-art"><span class="flow-node node-a">Need</span><span class="flow-link"></span><span class="flow-node node-b">Journey</span><span class="flow-link link-two"></span><span class="flow-node node-c">Interface</span><span class="flow-spark">✳</span></div>}
							{card.visual === 'system' && <div class="system-art"><div class="system-window"><div class="window-dots"><i></i><i></i><i></i></div><div class="swatch-row"><i></i><i></i><i></i><i></i></div><div class="system-lines"><i></i><i></i><i></i></div><div class="system-button">Button <span>↗</span></div></div><div class="system-token token-a">Aa</div><div class="system-token token-b">◈</div></div>}
							{card.visual === 'inclusive' && <div class="inclusive-art"><div class="inclusive-card"><span class="contrast-icon">◐</span><div class="inc-lines"><i></i><i></i></div><span class="inc-action">Continue <b>→</b></span></div><div class="direction-pill">LTR <span>⇄</span> RTL</div><span class="inclusive-spark">✳</span></div>}
							{card.visual === 'motion' && <div class="motion-art"><div class="motion-screen"><span class="motion-sun">✳</span><span class="motion-path path-one"></span><span class="motion-path path-two"></span><span class="motion-path path-three"></span><span class="motion-play">▶</span></div><span class="motion-label">prototype <b>● ● ●</b></span></div>}
						</div>
						<div class="timeline-marker" aria-hidden="true">{card.number}</div>
						<div class="impact-copy">
							<div class="card-meta"><span>{card.category}</span></div>
							<h3>{card.title}</h3>
							<p>{card.description}</p>
						</div>
					</article>
				))}
			</div>
		</section>

	</main>
	<SiteFooter />
</Layout>
