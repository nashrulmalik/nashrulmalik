---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import cv from '../data/cv.json';

const { personal_info, experience, education, credentials_and_certifications, skills } = cv;
const currentRole = experience.find((item) => item.dates.is_current);
const googleCert = credentials_and_certifications.find((item) => item.id === 'cert_google_ux_01');
---

<Layout title={`About — ${personal_info.full_name}`} description="Learn about Muhammad Nashrul Malik's product design experience, education, and approach.">
	<SiteHeader currentPage="about" />
	<main id="top">
		<section class="about-section bg-[#f2f2ed] py-16 pb-20 max-[620px]:py-12" aria-labelledby="about-title">
			<div class="wrap mx-auto w-[calc(100%-112px)] max-w-[1300px] max-[900px]:w-[calc(100%-60px)] max-[620px]:w-[calc(100%-38px)]">
				<p class="eyebrow mb-4 flex items-center gap-2 text-xs font-bold tracking-[.13em] text-[#626966]">ABOUT ME <span class="heading-line"></span></p>
				<div class="grid grid-cols-[.8fr_1.2fr] gap-[10%] max-[900px]:grid-cols-1 max-[900px]:gap-7">
					<div>
						<h1 class="mb-6 max-w-[11ch] font-display text-[clamp(42px,5vw,68px)] font-semibold leading-[1.02] tracking-[-.065em] max-[900px]:max-w-[15ch] max-[620px]:text-[42px]" id="about-title">Good design is a team sport<span class="accent-dot">.</span></h1>
						<p class="about-lede mb-0 font-display text-[21px] font-medium leading-[1.5] tracking-[-.025em] text-[#37413e] max-[620px]:text-[19px]">I bring a systems mindset, a curious nature, and a steady focus on the people using the product.</p>
					</div>
					<div class="about-content max-w-[700px]">
						<p class="about-detail mb-7 text-base leading-[1.75] text-[#535b57]">For nearly seven years at {currentRole.company}, I’ve worked remotely with cross-functional teams to shape enterprise software. My work includes managing a 1,500+ screen prototype, building scalable Figma systems, and establishing usability, accessibility, and right-to-left localization standards.</p>
						<p class="about-detail mb-0 text-base leading-[1.75] text-[#535b57]">I started in visual and interface design, then studied electrical engineering. That mix helps me move between customer needs, product logic, and implementation details—and work closely with the people bringing an experience to life.</p>
					</div>
				</div>

				<div class="mt-14 border-t border-[#dcdfd8] pt-8 max-[620px]:mt-10">
					<p class="eyebrow mb-6 flex items-center gap-2 text-xs font-bold tracking-[.13em] text-[#626966]">EXPERIENCE & FOUNDATION <span class="heading-line"></span></p>
					<div class="grid grid-cols-3 gap-6 max-[900px]:grid-cols-2 max-[620px]:grid-cols-1">
						{experience.map((item) => (
							<article class="experience-card rounded-sm border border-[#dfe3dc] bg-[#fbfaf8] p-6 max-[620px]:p-5">
								<p class="mb-3 text-xs font-semibold tracking-[.08em] text-brand-blue-dark">{item.dates.label}</p>
								<h2 class="mb-1 font-display text-xl font-semibold tracking-[-.03em]">{item.role}</h2>
								<p class="mb-4 text-[15px] text-[#58615d]">{item.company} · {item.mode}</p>
								<p class="mb-0 text-[15px] leading-[1.7] text-[#535b57]">{item.summary}</p>
							</article>
						))}
						<article class="experience-card rounded-sm border border-[#dfe3dc] bg-[#fbfaf8] p-6 max-[620px]:p-5">
							<p class="mb-3 text-xs font-semibold tracking-[.08em] text-brand-blue-dark">2013–2017</p>
							<h2 class="mb-1 font-display text-xl font-semibold tracking-[-.03em]">{education[0].degree}</h2>
							<p class="mb-4 text-[15px] text-[#58615d]">{education[0].institution} · {education[0].honor}</p>
							<p class="mb-0 text-[15px] leading-[1.7] text-[#535b57]">An engineering foundation in systems, architecture, and dependable interactions.</p>
						</article>
					</div>
				</div>

				<div class="mt-10 flex flex-wrap items-center gap-3">
					<span class="strip-label mr-1">TOOLS I USE</span>
					{skills.tools_and_software.map((tool) => <span class="tool-pill">{tool}</span>)}
				</div>
				<div class="credential mt-6 max-w-[520px]"><span class="credential-star">✳</span><span><b>{googleCert.title}</b><small>Research · Wireframing · Prototyping</small></span><span class="credential-mark">↗</span></div>
			</div>
		</section>
	</main>
	<SiteFooter />
</Layout>
